---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p>
      <span>{site.name}</span>
      <span aria-hidden="true"> · </span>
      <span data-zh lang="zh-CN">轨道档案</span>
      <span data-en lang="en">Orbital Archive</span>
      <span aria-hidden="true"> · </span>
      <span>{year}</span>
    </p>
    <ul
      class="site-footer__links"
      aria-label="联系方式"
      data-aria-label-zh="联系方式"
      data-aria-label-en="Contact links"
    >
      <li>
        <a
          href={site.github}
          aria-label={`${site.name} 的 GitHub 主页`}
          data-aria-label-zh={`${site.name} 的 GitHub 主页`}
          data-aria-label-en={`${site.name} GitHub profile`}
        >GitHub</a>
      </li>
      <li>
        <a
          href={`mailto:${site.email}`}
          aria-label={`发送邮件至 ${site.email}`}
          data-aria-label-zh={`发送邮件至 ${site.email}`}
          data-aria-label-en={`Email ${site.email}`}
        >{site.email}</a>
      </li>
    </ul>
  </div>
</footer>
